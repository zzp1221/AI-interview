      "name": "countBySessionId",
      "signature": "public abstract java.lang.Integer interview.modules.knowledgebase.repository.RagChatMessageRepository.countBySessionId(java.lang.Long)",
      "query": {
        "query": "SELECT COUNT(m) FROM RagChatMessageEntity m WHERE m.session.id = :sessionId"
      }
    },
    {
      "name": "countByType",
      "signature": "public abstract long interview.modules.knowledgebase.repository.RagChatMessageRepository.countByType(interview.modules.knowledgebase.model.RagChatMessageEntity$MessageType)",
      "query": {
        "query": "SELECT COUNT(r) FROM RagChatMessageEntity r WHERE r.type = :type"
      }
    },
    {
      "name": "countByUserIdAndType",
      "signature": "public abstract long interview.modules.knowledgebase.repository.RagChatMessageRepository.countByUserIdAndType(java.lang.Long,interview.modules.knowledgebase.model.RagChatMessageEntity$MessageType)",
      "query": {
        "query": "SELECT COUNT(m) FROM RagChatMessageEntity m WHERE m.session.userId = :userId AND m.type = :type"
      }
    },
    {
      "name": "deleteBySessionId",
      "signature": "public abstract void interview.modules.knowledgebase.repository.RagChatMessageRepository.deleteBySessionId(java.lang.Long)",
      "query": {
        "query": "SELECT r FROM RagChatMessageEntity r WHERE r.session.id = :sessionId"
