      "name": "findByResumeIdAndStatusIn",
      "signature": "public abstract java.util.Optional<interview.modules.interview.model.InterviewSessionEntity> interview.modules.interview.repository.InterviewSessionRepository.findByResumeIdAndStatusIn(java.lang.Long,java.util.List<interview.modules.interview.model.InterviewSessionEntity$SessionStatus>)",
      "query": {
        "query": "SELECT i FROM InterviewSessionEntity i WHERE i.resume.id = :resumeId AND i.status IN :statuses"
      }
    },
    {
