    },
    {
      "name": "findBySessionIdAndCompletedFalse",
      "signature": "public abstract java.util.List<interview.modules.knowledgebase.model.RagChatMessageEntity> interview.modules.knowledgebase.repository.RagChatMessageRepository.findBySessionIdAndCompletedFalse(java.lang.Long)",
      "query": {
