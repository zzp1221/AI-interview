    {
      "name": "searchByKeyword",
      "signature": "public abstract java.util.List<interview.modules.knowledgebase.model.KnowledgeBaseEntity> interview.modules.knowledgebase.repository.KnowledgeBaseRepository.searchByKeyword(java.lang.String)",
      "query": {
        "query": "SELECT k FROM KnowledgeBaseEntity k WHERE LOWER(k.name) LIKE LOWER(CONCAT('%', :keyword, '%')) OR LOWER(k.originalFilename) LIKE LOWER(CONCAT('%', :keyword, '%')) ORDER BY k.uploadedAt DESC"
      }
    },
    {
      "name": "searchByKeywordAndUserId",
      "signature": "public abstract java.util.List<interview.modules.knowledgebase.model.KnowledgeBaseEntity> interview.modules.knowledgebase.repository.KnowledgeBaseRepository.searchByKeywordAndUserId(java.lang.Long,java.lang.String)",
      "query": {
        "query": "SELECT k FROM KnowledgeBaseEntity k WHERE k.userId = :userId AND (LOWER(k.name) LIKE LOWER(CONCAT('%', :keyword, '%')) OR LOWER(k.originalFilename) LIKE LOWER(CONCAT('%', :keyword, '%'))) ORDER BY k.uploadedAt DESC"
      }
    },
    {
