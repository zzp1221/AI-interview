    },
    {
      "name": "findBySessionIdOrderByMessageOrderAsc",
      "signature": "public abstract java.util.List<interview.modules.knowledgebase.model.RagChatMessageEntity> interview.modules.knowledgebase.repository.RagChatMessageRepository.findBySessionIdOrderByMessageOrderAsc(java.lang.Long)",
      "query": {
        "query": "SELECT r FROM RagChatMessageEntity r WHERE r.session.id = :sessionId ORDER BY r.messageOrder asc"
      }
    },
    {
      "name": "findTopBySessionIdOrderByMessageOrderDesc",
      "signature": "public abstract java.util.Optional<interview.modules.knowledgebase.model.RagChatMessageEntity> interview.modules.knowledgebase.repository.RagChatMessageRepository.findTopBySessionIdOrderByMessageOrderDesc(java.lang.Long)",
